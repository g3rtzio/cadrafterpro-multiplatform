{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "cadrafterpro-web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/build",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/cmaps",
                "output": "cmaps"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/standard_fonts",
                "output": "standard_fonts"
              },
              {
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/wasm",
                "output": "wasm"
              },
              {
                "glob": "worker.min.js",
                "input": "node_modules/tesseract.js/dist",
                "output": "ocr"
              },
              {
                "glob": "tesseract-core*lstm.wasm.js",
                "input": "node_modules/tesseract.js-core",
                "output": "ocr/core"
              },
              {
                "glob": "eng.traineddata.gz",
                "input": "node_modules/@tesseract.js-data/eng/4.0.0_best_int",
                "output": "ocr/lang"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "allowedCommonJsDependencies": [
              "pako",
              "tesseract.js",
              "regenerator-runtime/runtime"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "cadrafterpro-web:build:production"
            },
            "development": {
              "buildTarget": "cadrafterpro-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}